# 환경 변수 예시. backend/.env로 복사해 채우거나, 셸에서 export 하거나, 배포 서버 환경 변수에 넣는다.
# PostgreSQL (docker-compose.yml의 db 서비스와 같은 값)
DATABASE_URL=postgresql+psycopg://jeonse:jeonse@localhost:5432/jeonse

# DB 설치 없이 실행할 때
# DATABASE_URL=sqlite:///./jeonse.db

# 규칙 파일 폴더 (기본: 저장소 최상위 rules/)
# RULES_DIR=../rules

# 공공데이터포털(data.go.kr) 일반 인증키
# - 이 파일을 backend/.env로 복사해 값을 채운다. .env는 git에 올리지 않는다 (진짜 키는 이 파일에 쓰지 않는다)
# - 계정당 1개. 활용신청한 API는 모두 같은 키를 쓴다. 각자 자기 계정으로 아래 API를 활용신청한다
#     국토교통부_아파트 매매 실거래가 자료         (사용: 매매 실거래가)
#     국토교통부_아파트 전월세 실거래가 자료       (사용: 주변 전세 시세)
#     국토교통부_연립다세대 매매 실거래가 자료     (사용: 매매 실거래가)
#     국토교통부_연립다세대 전월세 실거래가 자료   (사용: 주변 전세 시세)
#     국토교통부_오피스텔 전월세 실거래가 자료     (신청만, 아직 안 씀)
#     국토교통부_단독/다가구 전월세 실거래가 자료  (신청만, 아직 안 씀. 다가구·단독은 경보 대상 아님)
# - 마이페이지의 Encoding 키(%2B·%3D가 들어 있음)와 Decoding 키 중 아무거나 넣어도 된다 (Encoding 키는 서버가 풀어서 씀)
# - 엔드포인트 URL은 자원마다 달라 코드에 상수로 둔다 (여기에 넣지 않는다)
# - 서버는 .env를 자동으로 읽지 않는다. uvicorn app.main:app --host 0.0.0.0 --env-file .env 처럼 띄운다
DATA_GO_KR_SERVICE_KEY=

# 계약 생성에 테스트 결제(payment_id), 계약 아래 API에 접근 토큰(X-Contract-Token)을 꼭 요구할지 (API 명세 1.8)
# - 앱 연결 전까지 로컬 개발·시연은 false(없으면 통과, 보냈는데 틀리면 402·404)
# - 교수님 배포 서버는 처음부터 true (번호만 바꿔 남의 계약을 보지 못하게)
REQUIRE_CONTRACT_AUTH=false

# 시연용 가상 날짜(X-Virtual-Today 헤더)를 받을지 (API 명세 1.7)
# - 로컬 개발·시연은 true. 교수님 배포 서버는 false (헤더를 무시하고 실제 오늘, 한국 시간으로만 계산)
# - 시연을 배포 서버에서 하면 시연 서버는 true로 둔다 (false면 가상 날짜 시연이 안 됨)
ALLOW_VIRTUAL_TODAY=true

# 이메일 (FR-041 알림, 접근 링크 다시 받기)
# - console(기본): 보내지 않고 서버 로그에만 찍는다. smtp: 실제로 보낸다. memory: 테스트용
# - Gmail이면 SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=보내는 주소, SMTP_PASSWORD=앱 비밀번호(계정 비밀번호 아님)
EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true   # STARTTLS(587)만 지원. 465(SSL) 포트는 안 됨
# 접근 링크 이메일의 링크 앞부분. 앱의 내 계약 불러오기 경로까지 (예: jeonsecompanion://load-contract,
# Expo Go면 exp://<노트북 IP>:8081/--/load-contract). 비워 두면 링크 대신 접근 코드를 보낸다
# APP_LINK_BASE=

# 등기 항목 쉬운 말 설명 LLM (FR-007, Claude API). 키가 없으면 rules/explain.yaml 템플릿 설명만 쓴다 (진짜 키는 이 파일에 쓰지 않는다)
# ANTHROPIC_API_KEY=
# LLM_EXPLAIN=true          # false면 키가 있어도 템플릿만
# LLM_MODEL=claude-opus-5-5 # 비우면 rules/explain.yaml llm.model

# 관리자 API(/api/admin, 실거래가 수집) 토큰. 요청 헤더 X-Admin-Token에 같은 값을 보낸다. 비워 두면 관리자 API는 꺼진다
ADMIN_TOKEN=

# 밖에서 서버에 들어오는 주소 (캘린더 구독 주소 앞부분, #47). 비우면 요청이 들어온 주소. 배포 서버가 프록시 뒤면 채운다
# PUBLIC_BASE_URL=https://jeonse.example.ac.kr

# 증빙 사진을 저장할 폴더 (기본: backend/data/evidence, git에 올리지 않음)
# EVIDENCE_DIR=./data/evidence

# 웹(npx expo start --web)으로 개발할 때 API를 부를 수 있는 브라우저 주소 (CORS). 웹은 개발 편의용
# - 기본은 끔(빈 값). 웹으로 개발할 때만 Expo 웹 개발 서버 주소를 쉼표로: http://localhost:8081,http://127.0.0.1:8081
# - 배포 서버는 비워 둔다. 휴대폰 앱(Expo Go)은 상관없음
CORS_ORIGINS=
