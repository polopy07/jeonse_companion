# 환경 변수 예시. 셸에서 export 하거나 배포 서버 환경 변수에 넣는다.
# PostgreSQL (docker-compose.yml의 db 서비스와 같은 값)
DATABASE_URL=postgresql+psycopg://jeonse:jeonse@localhost:5432/jeonse

# DB 설치 없이 실행할 때
# DATABASE_URL=sqlite:///./jeonse.db

# 규칙 파일 폴더 (기본: 저장소 최상위 rules/)
# RULES_DIR=../rules

# 공공데이터포털(data.go.kr) 일반 인증키
# - 계정당 1개. 신청한 API는 모두 이 키 하나를 쓴다
#   - 실거래가: 아파트 매매·전월세, 연립다세대 매매·전월세 (지금 수집에 씀)
#   - 실거래가: 단독/다가구 전월세, 오피스텔 전월세 (신청함, 수집 코드는 아직 없음)
#   - 건축물대장
# - Encoding 키가 아니라 Decoding 키를 넣는다. requests의 params로 보내면 인코딩은 자동이고,
#   Encoding 키를 넣으면 %가 다시 인코딩돼 SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 난다
# - 엔드포인트 URL은 자원마다 달라 코드에 상수로 둔다 (여기에 넣지 않는다)
DATA_GO_KR_SERVICE_KEY=

# 관리자 API(/api/admin, 실거래가 수집) 토큰. 요청 헤더 X-Admin-Token에 같은 값을 보낸다. 비워 두면 관리자 API는 꺼진다
ADMIN_TOKEN=
