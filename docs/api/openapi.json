        "required": [
          "id",
          "level",
          "label",
          "next_step",
          "block_payment",
          "estimated_price",
          "deposit_ratio",
          "ratio_is_minimum",
          "matched",
          "linkages",
          "unchecked",
          "disclaimer",
          "rules_version"
        ],
        "title": "CheckResult"
      },
      "ContractInput": {
        "properties": {
          "check_id": {
            "type": "integer",
            "title": "Check Id",
            "description": "POST /api/checks로 만든 판정 결과 id"
          },
          "contract_date": {
            "type": "string",
            "format": "date",
            "title": "Contract Date",
            "description": "계약일"
          },
          "balance_date": {
            "type": "string",
            "format": "date",
            "title": "Balance Date",
            "description": "잔금일"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date",
            "description": "만기일"
          },
          "monthly_rent": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Monthly Rent",
            "description": "월세 (원, 전세면 0)",
            "default": 0
          },
          "loan": {
            "type": "boolean",
            "title": "Loan",
            "description": "전세대출 유무",
            "default": false
