          "linkages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Linkages"
          },
          "unchecked": {
            "items": {
              "$ref": "#/components/schemas/UncheckedItemOut"
            },
            "type": "array",
            "title": "Unchecked"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "rules_version": {
            "type": "string",
            "title": "Rules Version"
          }
