            "title": "Building Violation",
            "description": "건축물대장 위반건축물 여부, 모르면 비워 둠"
          },
          "guarantor_consult": {
            "type": "string",
            "enum": [
              "not_yet",
              "possible",
              "impossible"
            ],
            "title": "Guarantor Consult",
            "default": "not_yet"
          }
        },
        "type": "object",
        "required": [
          "housing_type",
          "deposit"
        ],
        "title": "CheckInput",
        "description": "계약 전 확인 입력 (FR-001)."
      },
      "CheckResult": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
