          "renewal_right_used": {
            "type": "boolean",
            "title": "Renewal Right Used",
            "description": "계약갱신요구권을 써서 갱신한 계약인지",
            "default": false
          },
          "co_tenant": {
            "type": "boolean",
            "title": "Co Tenant",
            "description": "공동 계약자(부부) 여부",
            "default": false
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254,
                "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "알림 이메일"
          },
          "special_term_result": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "inserted",
                "rejected"
