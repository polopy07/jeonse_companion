            "title": "Guarantor",
            "description": "보증기관 (미가입은 none)",
            "default": "none"
          },
          "brokered": {
            "type": "boolean",
            "title": "Brokered",
            "description": "중개 거래 여부 (직거래면 false)",
            "default": true
