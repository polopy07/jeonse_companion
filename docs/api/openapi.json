    "schemas": {
      "Body_parse_registry_api_registry_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_parse_registry_api_registry_parse_post"
      },
      "CheckInput": {
        "properties": {
          "housing_type": {
            "type": "string",
            "enum": [
              "apartment",
              "row_house",
              "officetel",
              "multi_household",
              "detached"
            ],
            "title": "Housing Type"
          },
          "deposit": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Deposit",
            "description": "보증금 (원)"
          },
          "official_price": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Official Price",
            "description": "공동주택 공시가격 (원)"
          },
          "trade_price": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Price",
            "description": "같은 단지·비슷한 면적 매매 실거래가 (원)"
          },
          "exclusive_area": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclusive Area",
            "description": "전용면적 (㎡)"
          },
          "registry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegistryInput"
              },
              {
                "type": "null"
              }
            ],
            "description": "등기부를 올리기 전이면 비워 둠"
          },
          "trust_consent": {
            "type": "string",
            "enum": [
              "unknown",
              "obtained",
              "unavailable"
            ],
            "title": "Trust Consent",
            "default": "unknown"
          },
          "building_violation": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
